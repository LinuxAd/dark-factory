# Sandbox Job pod spec shared by `make smoke` and `make sandbox-probe` (plan
# Step 7). Rendered by scripts/lib.sh (render); not synced by Argo CD.
# Placeholders (dollar-brace form): JOB_NAME, NAMESPACE, IMAGE, SECRET_NAME,
# COMMAND (a JSON array) and PURPOSE.
#
# The per-run Secret holds exactly ANTHROPIC_AUTH_TOKEN, the
# gateway token minted for this run. Nothing else in the pod is a credential:
# SA sandbox has no Pod Identity association and no API token.
#
# The wait-for-policy init container closes the window between pod start and
# VPC CNI applying the namespace's NetworkPolicies (security review H3): it
# polls a direct, unproxied HTTPS call to api.anthropic.com until that call
# fails, so the runner container only starts once enforcement is live. If
# egress is still open after 60s it exits 1 and the Job fails. scripts/lib.sh
# run_job deletes the lines between the begin/end markers when called with
# WAIT_FOR_POLICY=0 (the CONTROL=1 probe, whose namespace has no policies).
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_NAME}
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/part-of: factory
    factory/purpose: ${PURPOSE}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: factory
        factory/purpose: ${PURPOSE}
        factory/job: ${JOB_NAME}
    spec:
      restartPolicy: Never
      serviceAccountName: sandbox
      automountServiceAccountToken: false
      enableServiceLinks: false
      nodeSelector:
        platform/nodegroup: sandbox
      tolerations:
        - key: platform/sandbox
          operator: Equal
          value: "true"
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      # begin wait-for-policy
      initContainers:
        - name: wait-for-policy
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          command:
            - bash
            - -c
            - |
              deadline=$((SECONDS + 60))
              while ((SECONDS < deadline)); do
                if ! curl --noproxy '*' --silent --output /dev/null -m 2 https://api.anthropic.com; then
                  echo "wait-for-policy: direct egress to api.anthropic.com is blocked after $((SECONDS))s"
                  exit 0
                fi
                sleep 1
              done
              echo "wait-for-policy: direct egress to api.anthropic.com still open after 60s; NetworkPolicies are not enforced"
              exit 1
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop:
                - ALL
      # end wait-for-policy
      containers:
        - name: runner
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          command: ${COMMAND}
          envFrom:
            - secretRef:
                name: ${SECRET_NAME}
          env:
            - name: ANTHROPIC_BASE_URL
              value: http://gateway.factory.svc.cluster.local:8080
            - name: HTTPS_PROXY
              value: http://smokescreen.factory.svc.cluster.local:4750
            - name: HTTP_PROXY
              value: http://smokescreen.factory.svc.cluster.local:4750
            - name: NO_PROXY
              value: gateway.factory,gateway.factory.svc,gateway.factory.svc.cluster.local,.svc.cluster.local
            - name: CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
              value: "1"
            - name: DISABLE_TELEMETRY
              value: "1"
            - name: DISABLE_AUTOUPDATER
              value: "1"
            - name: HOME
              value: /home/runner
          resources:
            requests:
              cpu: 500m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: home
              mountPath: /home/runner
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: home
          emptyDir:
            sizeLimit: 1Gi
        - name: tmp
          emptyDir:
            sizeLimit: 1Gi
