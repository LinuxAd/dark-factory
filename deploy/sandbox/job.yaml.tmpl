# Sandbox Job pod spec shared by `make smoke` and `make sandbox-probe` (plan
# Step 7). Rendered by scripts/lib.sh (render); not synced by Argo CD.
# Placeholders (dollar-brace form): JOB_NAME, NAMESPACE, IMAGE, SECRET_NAME,
# COMMAND (a JSON array) and PURPOSE.
#
# The per-run Secret holds exactly ANTHROPIC_AUTH_TOKEN, the
# gateway token minted for this run. Nothing else in the pod is a credential:
# SA sandbox has no Pod Identity association and no API token.
#
# The wait-for-policy init container closes the window between pod start and
# VPC CNI applying the namespace's NetworkPolicies (security review H3, R1).
# It first needs a positive control: an unproxied GET of the gateway's
# /healthz, which proves the pod network is up and the gateway allow rule is
# live. Then it probes https://1.1.1.1/ directly (an IP, so DNS cannot be what
# fails) and counts only curl exit 28, a connect timeout from the policy
# dropping packets, as blocked. Three consecutive blocked probes let the
# runner start; any other result resets the count. Unproven after 60s
# (WAIT_FOR_POLICY_BUDGET overrides this, for local tests only) it exits 1 and
# the Job fails. run_job in scripts/lib.sh, given WAIT_FOR_POLICY 0 (the
# CONTROL=1 probe, whose namespace has no policies), deletes the init
# container block, both marker comment lines included. The marker text must
# not appear anywhere else in this file, or that sed range starts early.
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_NAME}
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/part-of: factory
    factory/purpose: ${PURPOSE}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: factory
        factory/purpose: ${PURPOSE}
        factory/job: ${JOB_NAME}
    spec:
      restartPolicy: Never
      serviceAccountName: sandbox
      automountServiceAccountToken: false
      enableServiceLinks: false
      nodeSelector:
        platform/nodegroup: sandbox
      tolerations:
        - key: platform/sandbox
          operator: Equal
          value: "true"
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      # begin wait-for-policy
      initContainers:
        - name: wait-for-policy
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          command:
            - bash
            - -c
            - |
              budget="${WAIT_FOR_POLICY_BUDGET:-60}"
              deadline=$((SECONDS + budget))
              blocked=0
              while ((SECONDS < deadline)); do
                if ! curl -sf --noproxy '*' -m 3 -o /dev/null http://gateway.factory.svc.cluster.local:8080/healthz; then
                  blocked=0
                  sleep 1
                  continue
                fi
                rc=0
                curl --noproxy '*' -s -o /dev/null --connect-timeout 2 https://1.1.1.1/ || rc=$?
                if ((rc == 28)); then
                  blocked=$((blocked + 1))
                  if ((blocked >= 3)); then
                    echo "wait-for-policy: gateway reachable and direct egress to 1.1.1.1 dropped 3 times in a row after $((SECONDS))s"
                    exit 0
                  fi
                else
                  blocked=0
                  sleep 1
                fi
              done
              echo "wait-for-policy: NetworkPolicy enforcement not proven after ${budget}s (gateway /healthz unreachable, or direct egress to 1.1.1.1 not timing out); failing the Job"
              exit 1
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop:
                - ALL
      # end wait-for-policy
      containers:
        - name: runner
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          command: ${COMMAND}
          envFrom:
            - secretRef:
                name: ${SECRET_NAME}
          env:
            - name: ANTHROPIC_BASE_URL
              value: http://gateway.factory.svc.cluster.local:8080
            - name: HTTPS_PROXY
              value: http://smokescreen.factory.svc.cluster.local:4750
            - name: HTTP_PROXY
              value: http://smokescreen.factory.svc.cluster.local:4750
            - name: NO_PROXY
              value: gateway.factory,gateway.factory.svc,gateway.factory.svc.cluster.local,.svc.cluster.local
            - name: CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
              value: "1"
            - name: DISABLE_TELEMETRY
              value: "1"
            - name: DISABLE_AUTOUPDATER
              value: "1"
            - name: HOME
              value: /home/runner
          resources:
            requests:
              cpu: 500m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 1Gi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: home
              mountPath: /home/runner
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: home
          emptyDir:
            sizeLimit: 1Gi
        - name: tmp
          emptyDir:
            sizeLimit: 1Gi
